# =============================================================================
# PocketPro:NYL - Environment Variables Template (local development)
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NOTE: Never commit the actual .env file to git. It contains secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# API Keys (optional — needed only for AI chat)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
CHAT_GPT_API_KEY=
GROK_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-3-mini-beta

# ---------------------------------------------------------------------------
# Backend / Chroma (container-internal)
# Must match docker-compose.yml container_name for chroma.
# ---------------------------------------------------------------------------
DATA_DIR=/data
CHROMA_HOST=pocketpro_nyl_chroma
CHROMA_PORT=8000
CHROMA_SDK_ENABLED=1

# Host binds (Windows: keep loopback to avoid IPv6/wslrelay issues)
DOCKER_BIND_HOST=127.0.0.1
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=5001
CHROMA_HOST_PORT=8001

# ---------------------------------------------------------------------------
# Frontend
# Leave empty for Docker: nginx proxies /api/* to the backend service.
# Set only for a standalone CRA/Vercel build that talks to a public API.
# ---------------------------------------------------------------------------
REACT_APP_API_BASE=

CHOKIDAR_USEPOLLING=true
DISABLE_ESLINT_PLUGIN=true
ESLINT_NO_DEV_ERRORS=true
TSC_COMPILE_ON_ERROR=true
HOME=/app
