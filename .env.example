# PocketProNYGames local env template — copy to .env (do not commit .env)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
CHAT_GPT_API_KEY=
CHATGPT_MODEL=gpt-4o-mini
# xAI Grok -- NOT Groq. Keep GROK_* and GROQ_* separate.
GROK_API_KEY=
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-3-mini-beta
# Groq (chain rung after Gemini; OpenAI-compatible endpoint).
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Local Ollama -- chain rung only when OLLAMA_ENABLED=1.
OLLAMA_ENABLED=
OLLAMA_API_BASE=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1:8b

DATA_DIR=/data
CHROMA_HOST=pocketpro_nygames_chroma
CHROMA_PORT=8000
CHROMA_SDK_ENABLED=1
PREDICTION_ENGINE=modular
PREDICTION_STATE_DIR=/data/prediction
SKIP_STARTUP_INGEST=0

# 0.0.0.0 is required on Docker Desktop Windows so host ports actually listen.
# Browse/test via 127.0.0.1 anyway.
DOCKER_BIND_HOST=0.0.0.0
# Host ports (container ports stay 80/5000). FRONTEND_PORT/BACKEND_PORT win;
# the *_HOST_PORT pair is read by start-windows.ps1 and scripts/, so keep them equal.
FRONTEND_PORT=3002
BACKEND_PORT=5002
FRONTEND_HOST_PORT=3002
BACKEND_HOST_PORT=5002
CHROMA_HOST_PORT=8001

# Only for `npm start` outside Docker; Docker builds use "" and the nginx /api proxy.
REACT_APP_API_BASE=http://localhost:5002

# Browser access allowed to the frontend when running locally or via Docker Desktop.
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Optional API-key gate (backend/middleware/auth.py). Leave off for local use.
# AUTH_MODE=apikey  -> every /api call needs X-API-Key (health stays public)
AUTH_MODE=off
API_KEYS=
ADMIN_API_KEYS=

# GHCR images (docker-compose.ghcr.yml): tag = latest (main), sha-<7 chars>, full commit SHA, or a branch name.
POCKETPRO_NYL_REGISTRY=ghcr.io/adportfolionode
POCKETPRO_NYL_VERSION=latest

# Pattern search (dynamic): auto-rerun after ingests, adaptive windows, auto promote/demote.
# Any key can be overridden per game with a _<GAME> suffix, e.g. PATTERN_WINDOWS_TAKE5=50,100,all
PATTERN_AUTO_ENABLED=1
PATTERN_RERUN_DEBOUNCE_SECONDS=30
PATTERN_WINDOWS=25,50,100,200,all
PATTERN_FDR_Q=0.10
PATTERN_MIN_DRAWS=150
PATTERN_HISTORY_LIMIT=1000
PATTERN_AUTO_PROMOTE=1
PATTERN_DEMOTE_MIN_NEW_DRAWS=30
PATTERN_CHAIN_HISTORY_LIMIT=400
